<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RaceLogger.Updater.MainWindow"
        Title="RaceLogger Updater"
        Width="500" Height="380"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None" 
        Background="#1e1e1e">

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center" Spacing="8">
            
            <TextBlock Text="Updating..." 
                       FontSize="36" 
                       FontWeight="SemiBold" 
                       Foreground="#e4e4e4" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

            <!-- Progress Bar -->
            <ProgressBar x:Name="UpdateProgressBar" 
                         Height="12" 
                         Minimum="0" Maximum="100" Value="0" 
                         Foreground="#a900ff" 
                         Background="#444" 
                         CornerRadius="6"/>

            <!-- Percentage and Details Toggle -->
            <Grid>
                <TextBlock x:Name="PercentageText" Text="0%" Foreground="#e4e4e4" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Cursor="Hand" PointerPressed="DetailsToggle_PointerPressed" Background="Transparent">
                    <TextBlock Text="Details" Foreground="#888" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DetailsArrowText" Text="v" Foreground="#888" FontSize="12" VerticalAlignment="Center" Margin="10,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Expander Box for Logs -->
            <Border x:Name="DetailsPanel" 
                    IsVisible="False" 
                    Background="#252525" 
                    CornerRadius="8" 
                    BorderBrush="#333"
                    BorderThickness="1"
                    Padding="15" 
                    Height="150" 
                    Margin="0,15,0,0">
                <ScrollViewer x:Name="LogScrollViewer">
                    <TextBlock x:Name="LogText" Foreground="#a0a0a0" FontSize="12" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
            
        </StackPanel>
    </Grid>
</Window>